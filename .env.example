# ============================================================
#  QREALAB CMS — Variables de entorno
#  Copia este archivo como .env y completa los valores.
#  NUNCA subas .env a GitHub.
# ============================================================

# ── Payload ──────────────────────────────────────────────────
# Genera una clave en: https://generate-secret.vercel.app/32
PAYLOAD_SECRET=REEMPLAZA_CON_CLAVE_32_CHARS

# URL donde corre este backend (local o Railway)
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# ── Base de datos (PostgreSQL) ────────────────────────────────
# Local:      postgres://usuario:password@localhost:5432/qrealab-cms
# Producción: URL de Neon.tech o Railway PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Cloudflare R2 — almacenamiento de archivos ────────────────
# Obtén estos valores en: dash.cloudflare.com → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=tu-account-id
R2_BUCKET=qrealab-media
R2_ACCESS_KEY_ID=tu-access-key-id
R2_SECRET_ACCESS_KEY=tu-secret-access-key
# URL pública del bucket (R2 → bucket → Settings → Public Access)
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ── Frontend (para CORS) ──────────────────────────────────────
# Local: http://localhost:4200  |  Producción: URL de Vercel
FRONTEND_URL=https://qrealab.vercel.app

# ── Email (Resend — notificaciones de contacto) ───────────────
# Plan gratis: 3,000 emails/mes. Sin clave → emails omitidos (OK en local).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
