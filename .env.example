# ============================================================
#  QREALAB CMS — Variables de entorno
#  Copia este archivo como .env y completa los valores
#  NUNCA subas .env a GitHub
# ============================================================

# ── Payload ──────────────────────────────────────────────────
# Cadena aleatoria larga (min 32 caracteres) para firmar tokens
# Genera una en: https://generate-secret.vercel.app/32
PAYLOAD_SECRET=REEMPLAZA_CON_CLAVE_ALEATORIA_32_CHARS

# URL pública donde correrá este backend en producción
# En Railway: https://tu-proyecto-xxxx.railway.app
PAYLOAD_PUBLIC_SERVER_URL=https://TU-BACKEND.railway.app

# ── Base de datos PostgreSQL (Neon.tech gratis) ───────────────
# Obtén esta URL en: https://neon.tech → Create project → Connection string
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# ── Cloudinary (imágenes — solo producción) ──────────────────
# ANTES de agregar estas vars, descomentar el plugin en payload.config.ts
# y ejecutar: pnpm add @payloadcms/storage-cloudinary@3.84.1
# Obtén estos valores en: cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=tu-api-secret-aqui

# ── Frontend (para CORS) ──────────────────────────────────────
# URL del frontend en Vercel (se conoce después de desplegar el front)
FRONTEND_URL=https://qrealab.vercel.app

# ── Email (Resend — notificaciones de contacto) ───────────────
# Crear cuenta gratis en: https://resend.com → API Keys
# Plan gratis: 3,000 emails/mes. Sin clave → emails omitidos (OK en local).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Node ─────────────────────────────────────────────────────
NODE_ENV=production
